<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>fi.ishtech.validation</groupId>
	<artifactId>hetu-validation</artifactId>
	<version>4.1.0</version>
	<packaging>pom</packaging>

	<name>hetu-validation</name>
	<description>Relocated to fi.ishtech.hetu:hetu-validation:5.0.0. Java package changed from fi.ishtech.validation to fi.ishtech.hetu.validation</description>
	<url>https://www.ishtech.fi/libs/hetu-validation-java</url>

	<organization>
		<name>IshTech</name>
		<url>https://www.ishtech.fi</url>
	</organization>

	<licenses>
		<license>
			<name>BSD-2-Clause</name>
			<url>https://opensource.org/license/bsd-2-clause</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Muneer Ahmed Syed</name>
			<url>https://github.com/muneer2ishtech</url>
			<roles>
				<role>architect</role>
				<role>developer</role>
			</roles>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/ishtech/hetu-validation-java</url>
	</scm>

	<distributionManagement>
		<relocation>
			<groupId>fi.ishtech.hetu</groupId>
			<artifactId>hetu-validation</artifactId>
			<version>5.0.0</version>
			<message>Relocated to fi.ishtech.hetu:hetu-validation:5.0.0. Java package changed from fi.ishtech.validation to fi.ishtech.hetu.validation</message>
		</relocation>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>

		<central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
	</properties>

	<profiles>
		<profile>
			<id>gpg</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>${maven-gpg-plugin.version}</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<configuration>
									<keyname>${gpg.keyname}</keyname>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>central-publishing</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>${central-publishing-maven-plugin.version}</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central-publishing</publishingServerId>
							<autoPublish>true</autoPublish>
							<waitUntil>published</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>